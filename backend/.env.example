# FinTrust Backend Configuration
# ==========================================

# 1. API SERVER SETTINGS
PORT=5000
NODE_ENV=development

# 2. DATABASE (MongoDB)
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/fintrust
MONGO_URI=mongodb://localhost:27017/fintrust

# 3. AUTHENTICATION (JWT)
JWT_SECRET=super_secret_production_ready_key_change_me
JWT_EXPIRES_IN=24h

# 4. BLOCKCHAIN (Ethereum Sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
WALLET_PRIVATE_KEY=your_private_key_without_0x_prefix
INVOICE_REGISTRY_CONTRACT=0xYourContractAddressOnSepolia

# 5. EVENT LISTENERS (Blockchain)
# Set to 'false' to disable event listeners (recommended for Infura free tier to avoid rate limits)
ENABLE_EVENT_LISTENERS=false

# 6. IPFS (Infura or Pinata)
IPFS_PROJECT_ID=your_ipfs_project_id
IPFS_PROJECT_SECRET=your_ipfs_project_secret
IPFS_GATEWAY=https://ipfs.infura.io/ipfs/

# Rate Limiting

RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
